{
  "name": "jev-dev-kit",
  "version": "0.1.2",
  "description": "Framework for agents on TypeSafe Jev: Jev only chooses; candidates and text come through explicit providers; the loop, validation, fallbacks and traces are built in.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }
  },
  "files": ["dist", "README.md", "DESIGN.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build",
    "prepare": "npm run build"
  },
  "repository": { "type": "git", "url": "https://github.com/chy4pro/jev-dev-kit.git" },
  "keywords": ["jev", "typesafe", "decision-model", "agent-framework", "system-one", "agent", "browser-agent"],
  "engines": { "node": ">=20" },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
